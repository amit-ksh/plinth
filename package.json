{
  "name": "stackleak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "npm run test:oracle && npm run test:native && npm run test:wasm && npm run test:app && npm run test:store && npm run test:mcp",
    "test:oracle": "node --experimental-strip-types --no-warnings --test packages/core/test/oracle.selftest.ts",
    "test:native": "node --experimental-strip-types --no-warnings --test packages/core/test/engine.native.test.ts",
    "test:wasm": "node --experimental-strip-types --no-warnings --test packages/core/test/engine.wasm.test.ts",
    "test:store": "node --experimental-strip-types --no-warnings --test packages/core/test/store.test.ts",
    "demo:build": "node --experimental-strip-types --no-warnings scripts/build-store.ts",
    "demo:audit": "node --experimental-strip-types --no-warnings scripts/audit-demo.ts",
    "dev": "npm run dev -w @app/web",
    "build": "npm run build -w @app/web",
    "preview": "npm run preview -w @app/web",
    "test:app": "node --experimental-strip-types --no-warnings --test packages/core/test/app.native.test.ts && node --experimental-strip-types --no-warnings --test packages/core/test/app.wasm.test.ts",
    "test:mcp": "node --experimental-strip-types --no-warnings --test apps/mcp/server.test.ts",
    "store:import": "node --experimental-strip-types --no-warnings scripts/import-store.ts",
    "mcp": "node --experimental-strip-types --no-warnings apps/mcp/server.ts",
    "test:e2e": "node --experimental-strip-types --no-warnings scripts/e2e.ts",
    "start": "npm run build && npm run preview -- --port 4173"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "axe-core": "4.11.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  }
}
