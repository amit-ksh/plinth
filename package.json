{
  "name": "stackleak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.16" },
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:oracle && npm run test:native && npm run test:wasm && npm run test:store",
    "test:oracle": "node --experimental-strip-types --test packages/core/test/oracle.selftest.ts",
    "test:native": "node --experimental-strip-types --test packages/core/test/engine.native.test.ts",
    "test:wasm": "node --experimental-strip-types --test packages/core/test/engine.wasm.test.ts",
    "test:store": "node --experimental-strip-types --test packages/core/test/store.test.ts",
    "demo:build": "node --experimental-strip-types scripts/build-store.ts",
    "demo:audit": "node --experimental-strip-types scripts/audit-demo.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.9.3"
  }
}
