CREATE RANGE INDEX `Class_id` FOR (n:`Class`) ON (n.`id`);
CREATE RANGE INDEX `Collection_id` FOR (n:`Collection`) ON (n.`id`);
CREATE RANGE INDEX `Discount_id` FOR (n:`Discount`) ON (n.`id`);
CREATE RANGE INDEX `Tag_id` FOR (n:`Tag`) ON (n.`id`);
CREATE RANGE INDEX `Variant_id` FOR (n:`Variant`) ON (n.`id`);
